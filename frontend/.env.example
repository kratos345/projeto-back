# Frontend Environment Configuration
# Copie este arquivo para .env e configure com os valores corretos para sua máquina

# URL do Backend API
# =====================================================

# OPÇÃO 1: Máquina Local (Tudo em 1 PC)
VITE_API_URL=http://localhost:3001

# OPÇÃO 2: Backend em Outro PC na Rede (substitua o IP)
# VITE_API_URL=http://192.168.1.100:3001

# OPÇÃO 3: Acessar via Termux/Android (usar IP do PC)
# VITE_API_URL=http://192.168.1.100:3001

# OPÇÃO 4: Backend em Servidor Remoto
# VITE_API_URL=https://seu-servidor.com/api

# =====================================================
# Como descobrir o IP do seu PC?
# Windows: cmd -> ipconfig
# Linux/Mac: terminal -> ifconfig
# =====================================================

